# Shared development configuration.
#
# TRACKED IN GIT. Local-only values, never real secrets — the Postgres here is the
# throwaway container from infra/docker-compose.yml.
#
# Injected into the process environment by `pnpm dev` (via dotenvx); no app reads
# this file directly. App-specific values live in apps/*/.env.development.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=streamshare

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/streamshare

# Shared between web (issues sessions) and signaling (verifies them). They must
# match or WebSocket auth fails. Regenerate: openssl rand -hex 32
AUTH_SECRET=9ef3ac30e2f08e179dcb9970c31a847126ede9c66539152d3948b25c9ea52951

# Google OAuth is optional in development — the guest provider covers most flows.
# Fill these in to exercise the Google sign-in path locally.
GOOGLE_CLIENT_ID=dev-unused
GOOGLE_CLIENT_SECRET=dev-unused
