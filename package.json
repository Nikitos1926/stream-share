{
  "name": "stream-share",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:desktop": "concurrently \"pnpm --filter @stream-share/web dev\" \"wait-on http://localhost:3000 && pnpm --filter @stream-share/desktop dev\"",
    "dev:lib": "concurrently \"pnpm --filter @stream-share/db dev\" \"wait-on ./packages/db/dist/index.js && pnpm --filter @stream-share/shared dev\"",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:reset": "node ./reset-db.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^1000.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "wait-on": "^9.0.10"
  },
  "packageManager": "pnpm@9.0.0"
}
