{
  "name": "stream-share",
  "version": "0.1.2",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm dev:lib\" \"wait-on ./packages/db/dist/index.js ./packages/env/dist/index.js ./packages/shared/dist/index.js && dotenvx run -q -f .env.development -- pnpm --parallel --filter @stream-share/signaling --filter @stream-share/web dev\"",
    "dev:desktop": "concurrently \"pnpm dev\" \"wait-on http://localhost:3000 && pnpm --filter @stream-share/desktop dev\"",
    "dev:lib": "pnpm lib:cleanup && pnpm dev:lib:start",
    "dev:lib:start": "concurrently \"pnpm --filter @stream-share/env dev\" \"pnpm --filter @stream-share/db dev\" \"wait-on ./packages/db/dist/index.js  && pnpm --filter @stream-share/shared dev\"",
    "lib:cleanup": "rimraf -g packages/*/dist",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "prod:config": "docker compose --env-file .env.production -f infra/docker-compose.prod.yml config -q",
    "prod:up": "docker compose --env-file .env.production -f infra/docker-compose.prod.yml up -d",
    "prod:down": "docker compose --env-file .env.production -f infra/docker-compose.prod.yml down",
    "db:reset": "dotenvx run -q -f .env.development -- node ./reset-db.mjs"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.22.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsup": "^8.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "wait-on": "^9.0.10"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
