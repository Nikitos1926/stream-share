# Template for the production .env.production at the repository root.
#
#   cp .env.example .env.production   # then fill in every blank
#
# This one file serves two distinct purposes:
#
#   1. Compose interpolation — the ${VAR} references inside
#      infra/docker-compose.prod.yml, supplied via `--env-file` (see `pnpm prod:up`).
#   2. Container environment — injected into services via `env_file:`.
#
# Per-app values live in apps/*/.env.production; see the matching .example there.
#
# The placeholder values below are non-empty so that
# `docker compose --env-file .env.example ... config` validates in CI. They are
# not usable defaults.

# --- Compose interpolation ---------------------------------------------------

# Public hostname Caddy terminates TLS for. Must resolve to this host.
PUBLIC_HOST=example.com
# Address Let's Encrypt sends expiry notices to.
ACME_EMAIL=admin@example.com
# GHCR path the images were pushed to, without the trailing image name.
REGISTRY=ghcr.io/owner/stream-share
# Image tag to run. The deploy job sets this from the git tag.
IMAGE_TAG=latest

# --- WebRTC media ports ------------------------------------------------------

# The UDP/TCP range mediasoup allocates transports from. It lives here, not in
# apps/signaling/.env.production, because Compose has to publish the same range
# on the host — and ${VAR} interpolation reads only this file, never a service's
# env_file. Keeping it in one place is what stops the two drifting apart.
#
# Signaling still receives both, since this file is also in its env_file list.
MEDIASOUP_RTC_MIN_PORT=10000
MEDIASOUP_RTC_MAX_PORT=10100

# --- Database ----------------------------------------------------------------

POSTGRES_USER=streamshare
POSTGRES_PASSWORD=
POSTGRES_DB=streamshare

# Host is the compose service name, not localhost.
#
# Spelled out literally rather than as ${POSTGRES_USER}:${POSTGRES_PASSWORD}@...
# Compose does interpolate env_file values, so the reference form works — but only
# on versions that support it, and when it is not supported the variable arrives
# unexpanded, still looks like a postgres:// URL, passes validation, and fails
# later at connection time. The credentials sit three lines above, so keeping them
# in step here is cheap; keep the two in sync.
DATABASE_URL=postgresql://streamshare:@postgres:5432/streamshare

# --- Auth --------------------------------------------------------------------

# Shared by web and signaling; they must match. Generate: openssl rand -hex 32
AUTH_SECRET=
