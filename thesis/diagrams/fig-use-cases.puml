@startuml
!pragma layout smetana
skinparam defaultFontName "Liberation Serif"
skinparam dpi 200
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontSize 12
skinparam packageStyle rectangle
left to right direction

actor "Гість" as Guest
actor "Користувач" as User
actor "Google" as Google <<зовнішня система>>

User -|> Guest

rectangle "Вебсервіс потокової трансляції" {
  package "Управління трансляцією" {
    usecase "Захопити окремий\nзастосунок" as UC_App
    usecase "Захопити екран, вікно\nабо вкладку браузера" as UC_Tab
    usecase "Вибрати джерело\nзахоплення" as UC_Source
    usecase "Налаштувати\nпараметри потоку" as UC_Config
    usecase "Запустити трансляцію" as UC_Start
    usecase "Отримати посилання\nна трансляцію" as UC_GetLink
    usecase "Завершити трансляцію" as UC_Stop
  }
  package "Перегляд трансляції" {
    usecase "Перейти до трансляції\nза посиланням" as UC_ByLink
    usecase "Обрати трансляцію в переліку\nактивних трансляцій" as UC_List
    usecase "Приєднатися\nдо трансляції" as UC_Join
    usecase "Відтворити відеопотік" as UC_Play
    usecase "Регулювати гучність\nі режим перегляду" as UC_Volume
  }
  package "Автентифікація" {
    usecase "Реєстрація та вхід\nчерез Google" as UC_Google
    usecase "Вихід із системи" as UC_Logout
  }
}

User -- UC_Config
User -- UC_Start
User -- UC_GetLink
User -- UC_Stop
User -- UC_Source
UC_Source <|-- UC_App
UC_Source <|-- UC_Tab

Guest -- UC_ByLink
User -- UC_List
UC_ByLink --|> UC_Join
UC_List --|> UC_Join
UC_Join ..> UC_Play : <<include>>
Guest -- UC_Volume

Guest -- UC_Google
UC_Google -- Google
' layout only: keeps Google on the right
UC_Play -[hidden]- Google
User -- UC_Logout
@enduml
