@startuml
!pragma layout smetana
skinparam defaultFontName "Liberation Serif"
skinparam dpi 200
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
hide footbox

actor "Користувач" as U
participant "Вікно застосунку\n(LoginProviders,\nwindow.conveyor)" as R
participant "Головний процес\n(сервер 127.0.0.1)" as M
participant "Системний\nбраузер" as B
participant "Вебзастосунок\n/api/desktop-auth/*" as W
participant "Auth.js\n/api/auth/*" as A
participant "Google" as G

U -> R : «Google»
R -> M : IPC auth:signInWithGoogle
M -> M : verifier, challenge = SHA-256(verifier),\nstate; listen(0, '127.0.0.1') → port
M -> B : shell.openExternal(\n/api/desktop-auth/start?port&state&challenge)
B -> W : GET /api/desktop-auth/start
W -> W : handoffRequestSchema, signOut(),\ncookie stream-share.desktop-auth (15 хв)
W -> A : signIn('google')
A --> B : 302 на сторінку входу Google
B -> G : вибір облікового запису\n(prompt = select_account)
G --> B : 302 /api/auth/callback/google
B -> A : код авторизації
A -> A : DrizzleAdapter: getUserByAccount /\ncreateUser + linkAccount
A --> B : cookie сеансу браузера,\n302 /api/desktop-auth/complete
B -> W : GET /api/desktop-auth/complete
W -> W : decodeHandoffRequest, auth();\nencodeHandoffCode(userId, challenge) (120 с)
W --> B : 302 http://127.0.0.1:port/callback?state&code
B -> M : GET /callback?state&code
M -> M : перевірка state
M --> B : «Signed in. You can close this tab…»
M --> R : {status: success, code, verifier}
R -> A : signIn('desktop', {code, verifier})
A -> A : redeemHandoffCode: SHA-256(verifier)\nзбігається з challenge; одноразовий jti
A --> R : cookie сеансу в сесії Electron
R -> R : router.replace('/')
@enduml
