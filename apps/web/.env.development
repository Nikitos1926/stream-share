# Web development configuration. Loaded by Next automatically.
#
# Shared values (DATABASE_URL, AUTH_SECRET, GOOGLE_*) come from the repository
# root .env.development, injected by `pnpm dev`.

# Server-side requests bypass the proxy and hit signaling directly. In production
# this is the compose service name; locally it is the dev signaling process.
SIGNALING_INTERNAL_URL=http://localhost:4000
