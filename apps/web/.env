# Public, non-secret defaults for the web client.
#
# TRACKED IN GIT, and deliberately allowed through .dockerignore so that
# `next build` can inline these into the client bundle. NEVER put a secret here —
# it would be committed AND baked into published image layers.
#
# NEXT_PUBLIC_* values are inlined at build time, not read at runtime. Changing
# one requires a rebuild, not a restart.

# Path Caddy strips before proxying to signaling. Must match `handle_path` in
# infra/caddy/Caddyfile.
NEXT_PUBLIC_PROXY_PREFIX=/sfu

# Development only: the browser talks to signaling directly, with no proxy in
# front. In production these are unused — requests go through the prefix above.
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4000
NEXT_PUBLIC_SIGNALING_WS_URL=ws://localhost:4000
