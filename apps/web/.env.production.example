# Template for apps/web/.env.production.
#
#   cp apps/web/.env.production.example apps/web/.env.production
#
# Delivered to the container by `env_file:` in infra/docker-compose.prod.yml.
# Shared values (DATABASE_URL, AUTH_SECRET) come from the root .env.production.

# The compose service name — NOT localhost, which inside this container resolves
# to the web server itself.
SIGNALING_INTERNAL_URL=http://signaling:4000

# https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: https://<PUBLIC_HOST>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
