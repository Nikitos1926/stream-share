# Template for apps/desktop/.env.production.
#
#   cp apps/desktop/.env.production.example apps/desktop/.env.production
#
# Read at build time, not run time: the value is inlined into the main bundle,
# so changing it needs a rebuild. Must match the PUBLIC_HOST the server is
# deployed behind — see the root .env.example.
WEB_URL=https://streamshare.space
