{
  "name": "@stream-share/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "Stream Share desktop app for broadcasting your screen and desktop audio",
  "author": {
    "name": "Nikita Kabakov",
    "email": "nikita.kabakov.work@gmail.com"
  },
  "homepage": "https://streamshare.space",
  "main": "out/main/main.js",
  "scripts": {
    "dev": "dotenvx run -q -f .env.development -- electron-vite dev -w",
    "build": "dotenvx run -q -f .env.production -- electron-vite build && electron-builder",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/rebuild-native.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-log": "^5.4.4",
    "electron-native-screenshare": "^1.2.0",
    "electron-updater": "^6.8.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.22.0",
    "@electron/rebuild": "^4.2.0",
    "@stream-share/env": "workspace:*",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "rollup-plugin-copy": "^3.5.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  }
}
