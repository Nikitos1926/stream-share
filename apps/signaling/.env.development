# Signaling development configuration.
#
# Injected by `pnpm dev` (via dotenvx) together with the repository root
# .env.development, which supplies DATABASE_URL and AUTH_SECRET.

PORT=4000
HOST=localhost

# The web dev server runs on a different origin, so CORS is required locally.
# In production Caddy serves both from one origin and this is left unset.
CORS_ORIGIN=http://localhost:3000

# Loopback is correct for local development: the browser and mediasoup are on the
# same machine. Production requires the host's real public IPv4.
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_RTC_MIN_PORT=10000
MEDIASOUP_RTC_MAX_PORT=10100
MEDIASOUP_NUM_WORKERS=1

THUMBNAILS_DIR=/data/thumbnails
