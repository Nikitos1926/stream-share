# Template for apps/signaling/.env.production.
#
#   cp apps/signaling/.env.production.example apps/signaling/.env.production
#
# Delivered to the container by `env_file:` in infra/docker-compose.prod.yml.
# Shared values (DATABASE_URL, AUTH_SECRET) come from the root .env.production.

PORT=4000
HOST=0.0.0.0

# CORS_ORIGIN is intentionally omitted: Caddy serves web and signaling from a
# single origin in production, so no cross-origin request is ever made.

# REQUIRED, and must be the public IPv4 address of this host — it is what ends up
# in the ICE candidates the browser dials back on. A loopback or private address
# here means every transport connects nowhere, with no error at startup.
# Left blank deliberately so startup fails loudly rather than half-working.
MEDIASOUP_ANNOUNCED_IP=

# MEDIASOUP_RTC_MIN_PORT / MEDIASOUP_RTC_MAX_PORT are deliberately NOT set here.
# Compose must publish the same range on the host, and ${VAR} interpolation reads
# only the root .env.production — so they are defined there, once, and reach this
# container through the same file.

# Defaults to the host's CPU count when unset.
MEDIASOUP_NUM_WORKERS=1

# Paths inside the container. THUMBNAILS_DIR is a named volume.
ASSETS_DIR=/app/apps/signaling/assets
THUMBNAILS_DIR=/data/thumbnails
