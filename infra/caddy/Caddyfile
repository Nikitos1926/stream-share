{
  email {$ACME_EMAIL}
}

{$PUBLIC_HOST} {
  encode zstd gzip

  # Everything under /sfu goes to signaling. handle_path strips the prefix,
  # so /sfu/streams arrives at Fastify as /streams — no route changes needed,
  # and new signaling routes never require a Caddyfile edit.
  handle_path /sfu/* {
    reverse_proxy signaling:4000
  }

  handle {
    reverse_proxy web:3000
  }
}
