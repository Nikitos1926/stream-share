# --- registry / release ---
REGISTRY=ghcr.io/nikitos1926/stream-share
IMAGE_TAG=latest

# --- database ---
POSTGRES_USER=streamshare
POSTGRES_PASSWORD=change-me
POSTGRES_DB=streamshare
DATABASE_URL=postgresql://streamshare:change-me@postgres:5432/streamshare

# --- auth (same secret in web + signaling) ---
AUTH_SECRET=            # openssl rand -hex 32
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- public origins ---
PUBLIC_WEB_ORIGIN=https://stream.example.com
MEDIASOUP_ANNOUNCED_IP=203.0.113.10
MEDIASOUP_NUM_WORKERS=2

# --- build-time only (GitHub Actions vars, baked into the web image) ---
NEXT_PUBLIC_SIGNALING_URL=https://api.stream.example.com
NEXT_PUBLIC_SIGNALING_WS_URL=wss://api.stream.example.com
